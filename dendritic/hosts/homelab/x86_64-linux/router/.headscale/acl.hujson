{
  "hosts": {
    "homelab": "10.0.10.0/24",
    "wow-server": "10.0.10.10/32",
    "nas": "192.168.1.3/32",
    "proxmox": "192.168.1.4/32"
  },

  "tagOwners": {
    "tag:homelab": ["pumita@"],
    "tag:gaming": ["pumita@"],
    "tag:media": ["pumita@"]
  },

  "acls": [
    // 1. pumita (personal user) and tag:homelab devices: full unrestricted access
    {
      "action": "accept",
      "src": ["pumita@", "tag:homelab"],
      "dst": ["*:*"]
    },

    // 2. Gaming (WoW / AzerothCore server auth and world ports)
    {
      "action": "accept",
      "src": ["tag:gaming"],
      "dst": [
        "wow-server:3724,8085"
      ]
    }

    // 3. Media: placeholder without access rules for now (default deny)
  ]
}
