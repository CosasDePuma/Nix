{
  "hosts": {
    "router": "100.64.0.1/32",
    "homelab": "10.0.10.0/24",
    "wow-server": "10.0.10.10/32",
    "nas": "192.168.1.3/32",
    "proxmox": "192.168.1.4/32"
  },

  "tagOwners": {
    "tag:homelab": ["pumita@"],
    "tag:gaming": ["pumita@"],
    "tag:media": ["pumita@"]
  },

  "acls": [
    // 1. Homelab: acceso exclusivo a toda la infraestructura .home. (router, VLAN 10, NAS, Proxmox)
    {
      "action": "accept",
      "src": ["tag:homelab"],
      "dst": [
        "router:*",
        "homelab:*",
        "nas:*",
        "proxmox:*"
      ]
    },

    // 2. Gaming: acceso exclusivamente al servidor WoW (AzerothCore: auth 3724, world 8085)
    {
      "action": "accept",
      "src": ["tag:gaming"],
      "dst": [
        "wow-server:3724,8085"
      ]
    }

    // 3. Media: de momento sin reglas de acceso (drop por defecto)
  ]
}
